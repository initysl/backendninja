# Dependencies
node_modules/

# Secrets — .env.example is committed as the contract, .env never is
.env
.env.local
.env.*.local

# Build and tooling output
dist/
build/
coverage/
*.tsbuildinfo
.npm/
.eslintcache

# Runtime scratch
tmp/
uploads/
*.log
logs/

# Reference material, not source
*.pdf

# Editor and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Accidental tsc output. Projects here never emit JS — noEmit plus Node's
# native type stripping — so a .js beside a .ts source is always a mistake.
**/src/**/*.js
**/test/**/*.js
