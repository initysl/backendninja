{
  "name": "bookmarks-api",
  "private": true,
  "type": "module",
  "description": "Practice project: CRUD in Express 5 with Zod validation, one RFC 9457 error envelope, and a streaming CSV import with proven backpressure",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "test": "NODE_ENV=test node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3",
    "express": "^5.2.1",
    "http-errors": "^2.0.1",
    "multer": "^2.4.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/http-errors": "^2.0.5",
    "@types/multer": "^2.2.0",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2"
  }
}
