# Copy to .env and adjust. .env is gitignored; this file is committed as the contract.
# Every variable listed here should be required by src/config/env.ts, so a missing one
# fails at boot rather than on the first request that needs it.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# CSV import limits. These exist because the upload is untrusted input.
IMPORT_MAX_FILE_BYTES=10485760
IMPORT_MAX_ROWS=100000
IMPORT_MAX_RECORD_BYTES=65536

# How long a generated error report stays downloadable before cleanup.
IMPORT_REPORT_TTL_SECONDS=3600
