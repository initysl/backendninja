meta {
  name: Create bookmark
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/bookmarks
  body: json
  auth: none
}

body:json {
  {
    "url": "https://nodejs.org",
    "title": "Node.js",
    "description": "The JavaScript runtime",
    "tags": ["node", "javascript"],
    "favorite": true
  }
}

assert {
  res.status: eq 201
  res.headers.location: isDefined
}

script:post-response {
  bru.setVar("bookmarkId", res.body.id);
}
